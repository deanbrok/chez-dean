# The page shell and code: always revalidate, so a new deploy shows up at once.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache

/style.css
  Cache-Control: no-cache

/scene.json
  Cache-Control: no-cache

# The model and the baked textures belong to one bake and must change together with scene.json. Their names are not
# hashed, so they revalidate on every visit too (a 304 when nothing changed): a day-long cache here once left visitors
# with yesterday's model under today's textures after a re-bake.
/bar.glb
  Cache-Control: no-cache

/tex/*
  Cache-Control: no-cache

# three.js is vendored at a fixed version.
/vendor/*
  Cache-Control: public, max-age=604800
