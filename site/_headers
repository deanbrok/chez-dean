# The page shell and code: always revalidate, so a new deploy shows up at once.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache

/*.js
  Cache-Control: no-cache

/style.css
  Cache-Control: no-cache

/scene.json
  Cache-Control: no-cache

# The model and the baked textures belong to one bake. The page asks for them as bar.glb?v=<stamp> and
# tex/<atlas>.jpg?v=<stamp>, with the stamp read from scene.json, so a re-bake changes their URLs; they also
# revalidate on every visit (a 304 when nothing changed).
/bar.glb
  Cache-Control: no-cache

/tex/*
  Cache-Control: no-cache

# three.js is vendored at a fixed version.
/vendor/*
  Cache-Control: public, max-age=604800
