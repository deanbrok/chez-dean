{
  // Cloudflare Workers with static assets: serves the ./site folder as-is. No build step, no Worker code.
  "name": "chez-dean",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // Cloudflare's per-branch preview builds run `npx wrangler preview`, which requires this block (it can stay empty;
  // assets and compatibility settings above are shared with previews).
  "previews": {}
}
